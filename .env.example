# Server Configuration
PORT=3000
NODE_ENV=development

# Database Connection (PostgreSQL)
# Local example: postgresql://USER:PASSWORD@localhost:5432/library_db?schema=public
# Render PostgreSQL example: postgresql://username:password@dpg-xxxx-a.oregon-postgres.render.com/library_db
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/library_db?schema=public"

# Session Security Secret (Generate a long random string for production)
SESSION_SECRET="college-library-super-secret-key-2026-production"

# Library Default Policy Configuration (Fallbacks)
DEFAULT_LOAN_DAYS=14
DEFAULT_FINE_PER_DAY=5.00
DEFAULT_MAX_BOOKS=3
DEFAULT_RENEWAL_LIMIT=2
